#randome variable generator functions

function dec_to_char() {
    printf "\x$(printf %x "$1")" | tee -a .magic
}

function random_number() {
    if [ $# -ne 2 ]; then
        echo "Usage: random_number <min> <max>"
        return 1
    fi

    local min=$1
        local max=$2

        if [ $min -gt $max ]; then
            echo "Error: Min should be less than Max"
            return 1
        fi

        echo $(( RANDOM % (max - min + 1) + min ))
}


function random_variable_name() {

    var_length=$(random_number 4 15)

    CHARSET_NUM="48 57"
    CHARSET_LOW="97 122"


    for c in  $(seq 1 $var_length)
    do
        if [ $c -eq 1 ]
        then
            dec_to_char $(random_number 97 122)
        fi

        select_charset=$(random_number 1 2)
        if [ $select_charset -eq 1 ]
        then
            seed=$(random_number $CHARSET_NUM)
        elif [ $select_charset -eq 2 ]
        then
            seed=$(random_number $CHARSET_LOW)
        fi

        dec_to_char $seed

    done

}




